@import url("unity-theme://default");

Button {
    -unity-text-align: middle-center;
    transition-duration: 0.12s;
    transition-property: opacity, background-color, border-color;
}

Button:disabled {
    opacity: 0.55;
}

.game-button:hover:enabled {
    border-left-color: rgb(121, 226, 210);
    border-right-color: rgb(121, 226, 210);
    background-color: rgb(39, 79, 77);
}

.game-button:focus {
    border-top-color: rgb(121, 226, 210);
    border-bottom-color: rgb(121, 226, 210);
}

.reduced-motion {
    transition-duration: 0s;
}

Scroller {
    opacity: 0.76;
}
